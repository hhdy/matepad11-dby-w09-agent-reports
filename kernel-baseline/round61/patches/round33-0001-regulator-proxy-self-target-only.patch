From 2a9d6c43b10b3e9b88a2c9f7d3f6b4a8c1e2d501 Mon Sep 17 00:00:00 2001
From: OpenAI 2号 AI <2nd-ai@users.noreply.github.com>
Date: Wed, 25 Nov 2026 22:30:00 +0800
Subject: [PATCH 16/17] regulator: require proxy consumers to target their owner

The proxy consumer is stored on its owner regulator_dev and is withdrawn
from that regulator's regulator_unregister() hook. A proxy-supply phandle
to a different regulator would outlive the target if it unregistered first.

Require child-scoped and legacy provider-scoped proxy-supply mappings to
identify the regulator child that owns the request. Reject cross-regulator
phandles before acquiring a handle or applying any vote. This preserves
the ROUND32 L5/L9 self-target mapping without adding reverse tracking.

Signed-off-by: OpenAI 2号 AI <2nd-ai@users.noreply.github.com>
---
 drivers/regulator/proxy-consumer.c | 44 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/drivers/regulator/proxy-consumer.c b/drivers/regulator/proxy-consumer.c
index 380884892539..a6f0d0f9a8b1 100644
--- a/drivers/regulator/proxy-consumer.c
+++ b/drivers/regulator/proxy-consumer.c
@@ -212,6 +212,30 @@ static struct regulator *proxy_consumer_get(struct proxy_consumer *consumer)
 	return regulator_get(consumer->reg_dev, "proxy");
 }
 
+/*
+ * Proxy handles are owned and released from the registering regulator's
+ * regulator_unregister() hook.  To make that lifetime sufficient, the
+ * supply phandle must identify the same regulator node that owns the
+ * request.  Do not rely on regulator_unregister()'s open_count warning:
+ * the core continues unregistering the target after issuing that warning.
+ */
+static int proxy_consumer_validate_self_target(struct device_node *owner_node,
+					       struct device_node *supply_node)
+{
+	struct device_node *target_node;
+	int rc = 0;
+
+	target_node = of_parse_phandle(supply_node, "proxy-supply", 0);
+	if (!target_node)
+		return -EINVAL;
+
+	if (target_node != owner_node)
+		rc = -EINVAL;
+
+	of_node_put(target_node);
+	return rc;
+}
+
 /**
  * regulator_proxy_consumer_register() - conditionally register a proxy consumer
  *		 for the specified regulator and set its boot time parameters
@@ -225,6 +246,7 @@ regulator_proxy_consumer_register(struct device *reg_dev,
 				  struct regulator_dev *rdev)
 {
 	struct proxy_consumer *consumer;
+	struct device_node *supply_node;
 	struct device_node *group_node;
 	const char *reg_name = "";
 	bool child_scoped;
@@ -250,6 +272,25 @@ regulator_proxy_consumer_register(struct device *reg_dev,
 		goto unlock;
 	}
 
+	/*
+	 * The per-rdev back-pointer below is also the lifetime owner of the
+	 * regulator handle.  Therefore both child-scoped and legacy
+	 * provider-scoped mappings are restricted to a self-target.  For the
+	 * legacy mapping, only the child named by the provider's proxy-supply
+	 * may carry proxy-consumer request properties.
+	 */
+	supply_node = child_scoped ? reg_node : group_node;
+	if (supply_node &&
+	    of_property_present(supply_node, "proxy-supply")) {
+		rc = proxy_consumer_validate_self_target(reg_node, supply_node);
+		if (rc) {
+			dev_err(reg_dev,
+				"%pOF: proxy-supply must target the regulator child owning this proxy request\n",
+				reg_node);
+			goto unlock;
+		}
+	}
+
 	if (dev_name(reg_dev))
 		reg_name = dev_name(reg_dev);
 
-- 
