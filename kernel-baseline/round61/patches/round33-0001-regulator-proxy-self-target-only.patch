From 2a9d6c43b10b3e9b88a2c9f7d3f6b4a8c1e2d501 Mon Sep 17 00:00:00 2001
From: OpenAI 2号 AI <2nd-ai@users.noreply.github.com>
Date: Wed, 25 Nov 2026 22:30:00 +0800
Subject: [PATCH 16/16] regulator: require proxy consumers to target their owner

The proxy consumer is stored on its owner regulator_dev and is withdrawn
from that regulator's regulator_unregister() hook.  A proxy-supply phandle
to a different regulator would therefore outlive the target if the target
unregistered first: regulator core warns about open_count but continues
unregistration.

Keep the lifetime model deliberately small and safe: require child-scoped
proxy-supply to point to the regulator child that owns the request.  Apply
the same restriction to the legacy provider-level mapping: only the child
named by the provider proxy-supply may carry proxy-consumer request
properties.  Reject cross-regulator phandles before acquiring a handle or
making any vote.  This preserves the ROUND32 L5/L9 self-target mapping and
the single-owner legacy case without introducing a second regulator-core
reverse-reference registry.

Document the runtime restriction in the binding.

Signed-off-by: OpenAI 2号 AI <2nd-ai@users.noreply.github.com>
---
 drivers/regulator/proxy-consumer.c                 | 36 ++++++++++++++++++++++
 Documentation/devicetree/bindings/regulator/qcom,rpmh-regulator.yaml | 15 ++++++---
 2 files changed, 46 insertions(+), 5 deletions(-)

diff --git a/drivers/regulator/proxy-consumer.c b/drivers/regulator/proxy-consumer.c
index 380884892539..a6f0d0f9a8b1 100644
--- a/drivers/regulator/proxy-consumer.c
+++ b/drivers/regulator/proxy-consumer.c
@@ -212,6 +212,27 @@ static struct regulator *proxy_consumer_get(struct proxy_consumer *consumer)
 	return regulator_get(consumer->reg_dev, "proxy");
 }
 
+/*
+ * Proxy handles are owned and released from the registering regulator's
+ * regulator_unregister() hook.  To make that lifetime sufficient, the
+ * supply phandle must identify the same regulator node that owns the
+ * request.  Do not rely on regulator_unregister()'s open_count warning:
+ * the core continues unregistering the target after issuing that warning.
+ */
+static int proxy_consumer_validate_self_target(struct device_node *owner_node,
+					       struct device_node *supply_node)
+{
+	struct device_node *target_node;
+	int rc = 0;
+
+	target_node = of_parse_phandle(supply_node, "proxy-supply", 0);
+	if (!target_node)
+		return -EINVAL;
+
+	if (target_node != owner_node)
+		rc = -EINVAL;
+
+	of_node_put(target_node);
+	return rc;
+}
+
 /**
  * regulator_proxy_consumer_register() - conditionally register a proxy consumer
  *		 for the specified regulator and set its boot time parameters
@@ -225,6 +246,7 @@ regulator_proxy_consumer_register(struct device *reg_dev,
 				  struct regulator_dev *rdev)
 {
 	struct proxy_consumer *consumer;
+	struct device_node *supply_node;
 	struct device_node *group_node;
 	const char *reg_name = "";
 	bool child_scoped;
@@ -250,6 +272,21 @@ regulator_proxy_consumer_register(struct device *reg_dev,
 		goto unlock;
 	}
 
+	/*
+	 * The per-rdev back-pointer below is also the lifetime owner of the
+	 * regulator handle.  Therefore both child-scoped and legacy
+	 * provider-scoped mappings are restricted to a self-target.  For the
+	 * legacy mapping, only the child named by the provider's proxy-supply
+	 * may carry proxy-consumer request properties.
+	 */
+	supply_node = child_scoped ? reg_node : group_node;
+	if (supply_node &&
+	    of_property_present(supply_node, "proxy-supply")) {
+		rc = proxy_consumer_validate_self_target(reg_node, supply_node);
+		if (rc) {
+			dev_err(reg_dev,
+				"%pOF: proxy-supply must target the regulator child owning this proxy request\n",
+				reg_node);
+			goto unlock;
+		}
+	}
+
 	if (dev_name(reg_dev))
 		reg_name = dev_name(reg_dev);
 
diff --git a/Documentation/devicetree/bindings/regulator/qcom,rpmh-regulator.yaml b/Documentation/devicetree/bindings/regulator/qcom,rpmh-regulator.yaml
index aea395fd6cfc..b7d2f7a48c11 100644
--- a/Documentation/devicetree/bindings/regulator/qcom,rpmh-regulator.yaml
+++ b/Documentation/devicetree/bindings/regulator/qcom,rpmh-regulator.yaml
@@ -118,9 +118,12 @@ properties:
 
         This provider-level declaration is the legacy group mapping: it
-        resolves one proxy target shared by every proxy request made on
-        this provider.  A provider-level proxy-supply and a child-level
-        proxy-supply must not be mixed on one provider; the kernel
-        rejects that combination instead of silently picking one.
+        resolves one proxy target for the provider.  Runtime validation
+        requires this phandle to identify the same regulator child that
+        owns each proxy request; consequently only that one child may
+        carry qcom,proxy-consumer-* properties when using the legacy
+        provider-level mapping.  A provider-level proxy-supply and a
+        child-level proxy-supply must not be mixed on one provider.
 
@@ -148,11 +151,11 @@ patternProperties:
       proxy-supply:
         description: |
             Phandle to the regulator that receives this child's temporary
             boot time proxy consumer requests described by the
-            qcom,proxy-consumer-* properties of this child.  For a
-            self-targeting mapping this is a phandle to this child node
-            itself, which lets two children of one flattened provider
-            node vote on two different regulators.  The requests are
-            withdrawn again at late_initcall_sync.  Must not be combined
-            with a provider-level proxy-supply on the same provider.
+            qcom,proxy-consumer-* properties of this child.  This phandle
+            must point to this child node itself.  This lets two children
+            of one flattened provider node vote independently on their
+            own regulators.  The requests are withdrawn again at
+            late_initcall_sync.  Must not be combined with a
+            provider-level proxy-supply on the same provider.
 
-- 
