From: OpenAI GPT-6
Subject: [DRAFT] ufs: qcom: add optional VCCQ parent regulator handling

DRAFT ONLY — source patch sketch for ACK android17-6.18; not a directly applicable git diff.
It has NOT been applied, compiled, schema-validated or runtime-tested.
Review against the exact pinned ACK checkout before use.

The HOS4.3 DBY-W09 UFS node declares qcom,vccq-parent-supply and a
210 mA max-load request pointing to the PM8150L S8 resource. The
upstream ACK UFS variant currently has no consumer for this property.
This draft adds an optional regulator enable/load lifecycle: the parent
rail is enabled while the UFS host is bound and released on init failure
or host exit. It deliberately does not add unverified suspend/resume
sequencing from a different downstream driver branch.

NOTE: ACK PM8150L S8 VRM ops do not currently implement DRMS set_load,
so regulator_set_load() may return success without a hardware mode change.
The patch preserves the request; it does not implement a PMIC-specific
load-to-mode policy.

--- a/drivers/ufs/host/ufs-qcom.h
+++ b/drivers/ufs/host/ufs-qcom.h
@@ [source-context anchor]
 struct gpio_desc;
+struct regulator;
 
 struct ufs_qcom_host {
 	struct phy *generic_phy;
 	struct ufs_hba *hba;
+	struct regulator *vccq_parent;
+	u32 vccq_parent_max_uA;
+	bool vccq_parent_enabled;
 	struct ufs_pa_layer_attr dev_req_params;
 	struct clk_bulk_data *clks;

--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@
 #include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
 #include <linux/reset-controller.h>

@@ insertion point: after the existing ufs_qcom_icc_init() definition and
@@ immediately before the ufs_qcom_init() documentation comment (around
@@ ACK android17-6.18 drivers/ufs/host/ufs-qcom.c line 1310)

+/*
+ * HOS downstream Qualcomm UFS trees expose qcom,vccq-parent-supply.
+ * Keep the rail enabled for the lifetime of the bound HBA in this
+ * conservative first-storage port. More granular link-off suspend /
+ * resume sequencing must be reconciled with the exact Huawei driver.
+ */
+static void ufs_qcom_disable_vccq_parent(struct ufs_qcom_host *host)
+{
+	int ret;
+
+	if (!host->vccq_parent || !host->vccq_parent_enabled)
+		return;
+
+	if (host->vccq_parent_max_uA) {
+		ret = regulator_set_load(host->vccq_parent, 0);
+		if (ret)
+			dev_warn(host->hba->dev,
+				 "failed to clear VCCQ parent load: %d\n", ret);
+	}
+
+	ret = regulator_disable(host->vccq_parent);
+	if (ret) {
+		dev_warn(host->hba->dev,
+			 "failed to disable VCCQ parent rail: %d\n", ret);
+		return;
+	}
+
+	host->vccq_parent_enabled = false;
+}
+
+static int ufs_qcom_enable_vccq_parent(struct ufs_qcom_host *host)
+{
+	struct device *dev = host->hba->dev;
+	int err;
+
+	if (!dev->of_node ||
+	    !of_find_property(dev->of_node, "qcom,vccq-parent-supply", NULL))
+		return 0;
+
+	err = of_property_read_u32(dev->of_node,
+				   "qcom,vccq-parent-max-microamp",
+				   &host->vccq_parent_max_uA);
+	if (err)
+		return dev_err_probe(dev, err,
+				     "missing VCCQ parent max-load property\n");
+
+	host->vccq_parent = devm_regulator_get_optional(dev, "qcom,vccq-parent");
+	if (IS_ERR(host->vccq_parent)) {
+		err = PTR_ERR(host->vccq_parent);
+		host->vccq_parent = NULL;
+		return dev_err_probe(dev, err,
+				     "failed to get VCCQ parent regulator\n");
+	}
+
+	err = regulator_enable(host->vccq_parent);
+	if (err)
+		return dev_err_probe(dev, err,
+				     "failed to enable VCCQ parent rail\n");
+
+	host->vccq_parent_enabled = true;
+
+	/*
+	 * On regulators with DRMS support this records the consumer load.
+	 * Current PM8150L S8 VRM ops may not implement set_load, in which
+	 * case regulator core can accept this request without changing mode.
+	 */
+	if (host->vccq_parent_max_uA) {
+		err = regulator_set_load(host->vccq_parent,
+					 host->vccq_parent_max_uA);
+		if (err) {
+			ufs_qcom_disable_vccq_parent(host);
+			return dev_err_probe(dev, err,
+					     "failed to vote VCCQ parent load\n");
+		}
+	}
+
+	return 0;
+}

@@
 	err = ufs_qcom_icc_init(host);
 	if (err)
 		goto out_variant_clear;
+
+	err = ufs_qcom_enable_vccq_parent(host);
+	if (err)
+		goto out_variant_clear;

@@
 out_variant_clear:
+	ufs_qcom_disable_vccq_parent(host);
 	ufshcd_set_variant(hba, NULL);

@@
 static void ufs_qcom_exit(struct ufs_hba *hba)
 {
 	struct ufs_qcom_host *host = ufshcd_get_variant(hba);

 	ufs_qcom_disable_lane_clks(host);
 	phy_power_off(host->generic_phy);
 	phy_exit(host->generic_phy);
+	ufs_qcom_disable_vccq_parent(host);
 }

--- a/Documentation/devicetree/bindings/ufs/qcom,ufs-common.yaml
+++ b/Documentation/devicetree/bindings/ufs/qcom,ufs-common.yaml
@@
 properties:
+  qcom,vccq-parent-supply:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Optional Qualcomm-specific parent supply for the UFS device VCCQ rail.
+      Consumed by Qualcomm UFS variant implementations that support this
+      downstream extension.
+
+  qcom,vccq-parent-max-microamp:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 1
+    description:
+      Maximum current requested from qcom,vccq-parent-supply.
 
   clocks:
@@
   resets:
     maxItems: 1

   '#reset-cells':
     const: 1

