From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DBY-W09 kernel port work <noreply@example.invalid>
Date: Tue, 24 Nov 2026 00:00:00 +0000
Subject: [PATCH DRAFT] dt-bindings: ufs: qcom: describe SM8250 UFS host

This binding currently selects Qualcomm UFS nodes by their first compatible,
but qcom,sm8250-ufshc is missing from both the select list and the compatible
enum even though the SM8250 DTSI uses:

  compatible = "qcom,sm8250-ufshc", "qcom,ufshc", "jedec,ufs-2.0";

The SM8250 host has eight clocks and no separate ICE register window. Add an
SM8250-specific schema branch rather than reusing the SM8150 rule (nine clocks
including ice_core_clk and two register ranges) or the QCS615/SM6115 rule
(which has ice_core_clk as its eighth clock and two register ranges).

No power-domain count or ordering is changed by this patch. The future
DBY-W09 dual-GenPD change requires its own source, binding and runtime review.

This is a draft only. dt_binding_check / dtbs_check have not been run.

---
 Documentation/devicetree/bindings/ufs/qcom,ufs.yaml | 23 +++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/Documentation/devicetree/bindings/ufs/qcom,ufs.yaml b/Documentation/devicetree/bindings/ufs/qcom,ufs.yaml
index 000000000000..111111111111 100644
--- a/Documentation/devicetree/bindings/ufs/qcom,ufs.yaml
+++ b/Documentation/devicetree/bindings/ufs/qcom,ufs.yaml
@@ -23,6 +23,7 @@ select:
           - qcom,sm6125-ufshc
           - qcom,sm6350-ufshc
           - qcom,sm8150-ufshc
+          - qcom,sm8250-ufshc
   required:
     - compatible
 
@@ -38,6 +39,7 @@ properties:
           - qcom,sm6125-ufshc
           - qcom,sm6350-ufshc
           - qcom,sm8150-ufshc
+          - qcom,sm8250-ufshc
       - const: qcom,ufshc
       - const: jedec,ufs-2.0
@@ -149,6 +151,29 @@ allOf:
           minItems: 2
           maxItems: 2
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: qcom,sm8250-ufshc
+    then:
+      properties:
+        clocks:
+          minItems: 8
+          maxItems: 8
+        clock-names:
+          items:
+            - const: core_clk
+            - const: bus_aggr_clk
+            - const: iface_clk
+            - const: core_clk_unipro
+            - const: ref_clk
+            - const: tx_lane0_sync_clk
+            - const: rx_lane0_sync_clk
+            - const: rx_lane1_sync_clk
+        reg:
+          minItems: 1
+          maxItems: 1
+
     # TODO: define clock bindings for qcom,msm8994-ufshc
 
   - if:
-- 
2.43.0
