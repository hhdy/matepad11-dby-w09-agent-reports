From 2a9d6c43b10b3e9b88a2c9f7d3f6b4a8c1e2d502 Mon Sep 17 00:00:00 2001
From: OpenAI 2号 AI <2nd-ai@users.noreply.github.com>
Date: Wed, 25 Nov 2026 22:30:00 +0800
Subject: [PATCH 17/17] dt-bindings: regulator: document proxy self-target rule

Document the runtime requirement that proxy-supply identify the regulator
child owning the proxy request, for both child-scoped and legacy mappings.

Signed-off-by: OpenAI 2号 AI <2nd-ai@users.noreply.github.com>
---
 Documentation/devicetree/bindings/regulator/qcom,rpmh-regulator.yaml | 15 ++++++---
 1 file changed, 9 insertions(+), 6 deletions(-)

diff --git a/Documentation/devicetree/bindings/regulator/qcom,rpmh-regulator.yaml b/Documentation/devicetree/bindings/regulator/qcom,rpmh-regulator.yaml
index aea395fd6cfc..b7d2f7a48c11 100644
--- a/Documentation/devicetree/bindings/regulator/qcom,rpmh-regulator.yaml
+++ b/Documentation/devicetree/bindings/regulator/qcom,rpmh-regulator.yaml
@@ -118,0 +118,0 @@ properties:
 
         This provider-level declaration is the legacy group mapping: it
-        resolves one proxy target shared by every proxy request made on
-        this provider.  A provider-level proxy-supply and a child-level
-        proxy-supply must not be mixed on one provider; the kernel
-        rejects that combination instead of silently picking one.
+        resolves one proxy target for the provider.  Runtime validation
+        requires this phandle to identify the same regulator child that
+        owns each proxy request; consequently only that one child may
+        carry qcom,proxy-consumer-* properties when using the legacy
+        provider-level mapping.  A provider-level proxy-supply and a
+        child-level proxy-supply must not be mixed on one provider.
 
@@ -148,0 +151,0 @@ patternProperties:
       proxy-supply:
         description: |
             Phandle to the regulator that receives this child's temporary
             boot time proxy consumer requests described by the
-            qcom,proxy-consumer-* properties of this child.  For a
-            self-targeting mapping this is a phandle to this child node
-            itself, which lets two children of one flattened provider
-            node vote on two different regulators.  The requests are
-            withdrawn again at late_initcall_sync.  Must not be combined
-            with a provider-level proxy-supply on the same provider.
+            qcom,proxy-consumer-* properties of this child.  This phandle
+            must point to this child node itself.  This lets two children
+            of one flattened provider node vote independently on their
+            own regulators.  The requests are withdrawn again at
+            late_initcall_sync.  Must not be combined with a
+            provider-level proxy-supply on the same provider.
 
