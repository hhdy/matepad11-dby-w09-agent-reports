/*
 * Huawei MatePad 11 (2021), DBY-W09 — ACK android17-6.18 board DTS draft.
 *
 * DRAFT ONLY: not dtc-compiled, schema-validated, boot-tested or approved
 * for packaging. This is the first minimal-storage bring-up skeleton.
 *
 * Source basis:
 *   - local HOS4.3 ROUND7–ROUND9 static inventory and regulator map;
 *   - ACK android17-6.18 SM8250 SoC DTSI;
 *   - same-device public Linux DTS used only as a structural cross-reference.
 *
 * The original HOS4.3 DTBO entry 8 is NOT compatible with this minimal base:
 * it contains 145 fragment targets into many Huawei vendor-only nodes.
 * Pair this base only with a separately reviewed minimal DBY-W09 rootparam
 * DTBO draft. Do not apply the stock entry 8 to this base.
 */

/dts-v1/;

#include <dt-bindings/arm/qcom,ids.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>

#include "sm8250.dtsi"

/ {
	model = "Huawei MatePad 11 (2021) DBY-W09";
	compatible = "huawei,dby-w09", "qcom,sm8250";
	chassis-type = "tablet";

	/*
	 * Local ROUND3 identity: MSM-ID [356, 131073] = SM8250 v2.1.
	 * Keep the SoC DTB board-id at zero; the separate DBY-W09 DTBO is
	 * selected by board-id 0x206a and fills /rootparam for Huawei ABL.
	 */
	qcom,msm-id = <QCOM_ID_SM8250 0x20001>;
	qcom,board-id = <0 0>;

	/*
	 * The label is required by dby-w09-ack18-rootparam.dtso.draft.
	 * Board identity values are populated by the matching DTBO. The local
	 * stock-DTBO inventory shows huawei,modem_id is the same generic
	 * sentinel in all nine entries; the minimal overlay preserves it.
	 */
	rootparam: rootparam {
	};
};

/*
 * The PM8150 output rails used by UFS are represented directly under the
 * SM8250 apps_rsc RPMh provider. The existing ROUND7 property inventory
 * confirms these regulator names and output-voltage windows, but does not
 * record regulator input-supply properties or resolve their parent source.
 *
 * The same-device Linux 7.0 reference uses a fixed 3.7 V vph_pwr node and
 * vdd-s*-supply links, but that is a cross-reference based on HOS4.2, not a
 * verified HOS4.3 fact. Do not copy that parent topology into this minimal
 * ACK DTS until a targeted local base-FDT check establishes it.
 */
&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm8150-rpmh-regulators";
		qcom,pmic-id = "a";


		/* HOS4.3: PM8150 S4, 1.8–1.92 V, initial level 1.8 V. */
		vreg_s4a_1p8: smps4 {
			regulator-name = "pm8150_s4";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1920000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* HOS4.3: PM8150 L5, fixed 0.88 V. */
		vreg_l5a_0p88: ldo5 {
			regulator-name = "pm8150_l5";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <880000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
		};

		/* HOS4.3: PM8150 L6, fixed 1.2 V; shared by VCCQ and PHY refclk. */
		vreg_l6a_1p2: ldo6 {
			regulator-name = "pm8150_l6";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
		};

		/* HOS4.3: PM8150 L9, fixed 1.2 V. */
		vreg_l9a_1p2: ldo9 {
			regulator-name = "pm8150_l9";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
		};

		/* HOS4.3: PM8150 L17, 2.496–3.008 V. */
		vreg_l17a_3p0: ldo17 {
			regulator-name = "pm8150_l17";
			regulator-min-microvolt = <2496000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

/*
 * The SoC DTSI already defines all SM8250 UFS register, clock, reset,
 * interconnect, lane and power-domain resources. Only board-level supplies
 * and enable status are added here.
 *
 * Deliberately omitted:
 *   - vdd-hba-supply: HOS maps this to UFS_PHY_GDSC, already expressed by
 *     the SoC power-domains property; it is not a regulator.
 *   - qcom,vccq-parent-supply: HOS downstream-only extension without an
 *     equivalent generic upstream UFS consumer property.
 *   - vcc-low-voltage-sup: not translated to vcc-supply-1p8 because the
 *     verified HOS VCC operating window is 2.504–2.950 V.
 */
&ufs_mem_hc {
	vcc-supply = <&vreg_l17a_3p0>;
	vcc-voltage-level = <2504000 2950000>;
	vcc-max-microamp = <800000>;

	vccq-supply = <&vreg_l6a_1p2>;
	vccq-max-microamp = <800000>;

	vccq2-supply = <&vreg_s4a_1p8>;
	vccq2-max-microamp = <800000>;

	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l5a_0p88>;
	vdda-phy-max-microamp = <89900>;

	vdda-pll-supply = <&vreg_l9a_1p2>;
	vdda-pll-max-microamp = <18800>;

	/* Optional QMP UFS PHY refclk rail; HOS maps it to the same PM8150 L6. */
	vddp-ref-clk-supply = <&vreg_l6a_1p2>;
	vddp-ref-clk-max-microamp = <100>;

	status = "okay";
};

/*
 * Later stages, intentionally not enabled in this minimal draft:
 *   &uart6 / GENI console
 *   &qupv3_id_2 / &spi14 / Huawei THP
 *   panel / dual DSI / backlight
 *   PCIe / QCA6391 WLAN + UART Bluetooth
 *   ADSP / audio / camera / USB-C / DP
 *
 * Do not select a panel profile here: ACTIVE_PROFILE remains UNKNOWN.
 */
