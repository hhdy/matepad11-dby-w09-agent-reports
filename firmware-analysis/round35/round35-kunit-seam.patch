diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
index d84f3d0..da30cc4 100644
--- a/drivers/regulator/Kconfig
+++ b/drivers/regulator/Kconfig
@@ -56,6 +56,32 @@ config REGULATOR_USERSPACE_CONSUMER
 
 	  If unsure, say no.
 
+config REGULATOR_PROXY_CONSUMER
+	bool "Boot time regulator proxy consumer support"
+	depends on OF
+	help
+	  This driver provides support for boot time regulator proxy requests.
+	  It can enforce a specified voltage range, set a minimum current,
+	  and/or keep a regulator enabled.  It is needed in circumstances where
+	  reducing one or more of these three quantities will cause hardware to
+	  stop working if performed before the driver managing the hardware has
+	  probed.  Proxy targets are resolved from device tree "proxy-supply"
+	  phandles, either scoped to the regulator child node or declared on
+	  the provider node.
+
+	  If unsure, say no.
+
+config REGULATOR_PROXY_CONSUMER_KUNIT_TEST
+	tristate "KUnit test for regulator proxy consumer lifecycle" if KUNIT
+	depends on KUNIT && REGULATOR_PROXY_CONSUMER && OF && OF_OVERLAY
+	depends on !KUNIT_ALL_TESTS
+	default n
+	help
+	  KUnit coverage for proxy-consumer bulk revoke and the owner
+	  unregister ordering seam.  Off by default and excluded from
+	  KUNIT_ALL_TESTS so it can never be enabled by a product config or
+	  defconfig; use it only in an isolated KUnit test configuration.
+
 config REGULATOR_NETLINK_EVENTS
 	bool "Enable support for receiving regulator events via netlink"
 	depends on NET
